__pycache__/
*.pyc

# Runtime state (grows continuously, not source) and local config that may
# hold a Telegram bot token/chat id - keep the example checked in instead.
state.json
config.json

# save_json()'s atomic-write temp file (app.py) - briefly exists mid-save,
# can get left behind (empty) if the process is killed at the wrong instant.
*.tmp
